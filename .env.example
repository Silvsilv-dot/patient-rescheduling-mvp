# Copy to .env for local development. NEVER commit the real .env file.
# Use a Neon branch that holds synthetic demo data only.
# Pooled Neon connection string with SSL, for example:
# postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
NEON_DATABASE_URL=

# Needed from batch 2 onward (leave empty for now):
TOKEN_SIGNING_KEY=
DEMO_STAFF_PIN_FRONTDESK=
DEMO_STAFF_PIN_MANAGER=

# Optional pool tuning
# DB_POOL_MIN=1
# DB_POOL_MAX=5
# DB_POOL_TIMEOUT_SECONDS=5

# Used only by the integration tests (a separate TEST database, which gets wiped):
# TEST_DATABASE_URL=
